rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada gasto vive en la colección "gastos" y tiene un campo userId.
    // Solo el usuario logueado dueño de ese userId puede leerlo o modificarlo.
    match /gastos/{gastoId} {
      allow read: if esDueno();

      allow create: if estaLogueado()
        && request.resource.data.userId == request.auth.uid;

      allow update: if esDueno()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if esDueno();
    }

    // Cualquier otra ruta queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }

    function estaLogueado() {
      return request.auth != null;
    }

    function esDueno() {
      return estaLogueado() && resource.data.userId == request.auth.uid;
    }
  }
}
